# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3000
NODE_ENV=development
# Set true when serving local development over HTTPS; production defaults to true.
COOKIE_SECURE=false
NOTIFICATION_SERVICE_URL=http://localhost:4000/notifications
OUTBOX_RETRY_DELAY_MS=5000
